{#_#_:mvn/repos 
 {"central"
  {:url "https://repo1.maven.org/maven2/"}
  "clojars"
  {:url "https://repo.clojars.org/"}}

 :paths ["src"]
 
 :aliases
 {:codox {:extra-deps {codox/codox {:mvn/version "0.10.8"}}
          :exec-fn codox.main/generate-docs
          :exec-args {:source-paths ["src"]}}
  :test {:extra-paths ["test"]
         :extra-deps {io.github.cognitect-labs/test-runner
                      {:git/tag "v0.5.1" :git/sha "dfb30dd"}}
         :main-opts ["-m" "cognitect.test-runner"]
         :exec-fn cognitect.test-runner.api/test}
  :kafka {:extra-paths ["integration"]
          :extra-deps {io.github.cognitect-labs/test-runner
                       {:git/tag "v0.5.1" :git/sha "dfb30dd"}}
          :exec-fn cognitect.test-runner.api/test
          :exec-args {:dirs ["integration"]}}
  :dev {:extra-deps {djblue/portal {:mvn/version "0.62.2"}
                     org.slf4j/slf4j-simple {:mvn/version "2.0.7"}}
        :jvm-opts ["-XX:+UseZGC"
                   "-XX:MaxRAMPercentage=50"
                   "-Djdk.attach.allowAttachSelf"
                   "--add-modules=jdk.incubator.vector"
                   "--enable-native-access=ALL-UNNAMED"]}}

 :deps
 {org.clojure/clojure                               {:mvn/version "1.12.3"}

  io.pedestal/pedestal.http-kit                     {:mvn/version "0.8.2"}

  ;; Serialization
  com.taoensso/nippy                                {:mvn/version "3.9.0"}
  net.openhft/zero-allocation-hashing               {:mvn/version "2026.0"}
  com.cnuernber/charred                             {:mvn/version "1.043"}

  ;; Kafka
  org.apache.kafka/kafka-clients                    {:mvn/version "4.4.0"}

  ;; Compression for storage artifacts
  org.apache.commons/commons-compress               {:mvn/version "1.28.0"}
  
  ;; RocksDB 
  org.rocksdb/rocksdbjni                            {:mvn/version "11.8.1"}
  
  ;; Jena 
  org.apache.jena/jena-arq                          {:mvn/version "6.2.0"}
  org.apache.jena/jena-core                         {:mvn/version "6.2.0"}
  org.apache.jena/jena-tdb2                         {:mvn/version "6.2.0"}
  org.apache.jena/jena-shacl                        {:mvn/version "6.2.0"}

  ;; Google Cloud
  com.google.cloud/google-cloud-secretmanager       {:mvn/version "2.100.0"}
  com.google.cloud/google-cloud-storage             {:mvn/version "2.76.0"}

}}

